# ===== REQUIRED =====

# Together AI (LLM)
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# SEC EDGAR (just your identity, not a key)
SEC_USER_AGENT=YourName your@email.com
SEC_BASE_URL=https://www.sec.gov
SEC_DATA_URL=https://data.sec.gov

# FRED (macro data)
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred/series/observations

# Logo.dev
LOGO_DEV_TOKEN=

# ===== OPTIONAL =====

# Financial Modeling Prep
FMP_API_KEY=

# Neon Postgres (pgvector)
DATABASE_URL=

# Embedding model (HuggingFace)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== APP CONFIG =====
PORT=8080
DEBUG=false
CORS_ORIGINS=*
HTTP_TIMEOUT=30

# ===== LLM / AGENT TUNING =====
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
AGENT_MAX_ITERATIONS=12
AGENT_TOOL_RESULT_MAX_CHARS=8000

# ===== SEC LIMITS =====
SEC_MAX_FILINGS=10
SEC_FILING_MAX_CHARS=20000

# ===== DATABASE POOL =====
DB_POOL_MIN=1
DB_POOL_MAX=5

# ===== EMBEDDING / RAG =====
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ===== FINANCIAL MODEL DEFAULTS =====
EQUITY_RISK_PREMIUM=0.055
CREDIT_SPREAD=0.015
FALLBACK_RISK_FREE_RATE=0.04
WACC_FLOOR=0.04
DEFAULT_STARTING_REVENUE=100000000000
DEFAULT_SHARES_OUTSTANDING=1000000000
DEFAULT_CURRENT_PRICE=100.0
